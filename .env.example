PANEL_ADMIN_USERNAME=admin
PANEL_ADMIN_PASSWORD=replace-with-a-long-unique-password
PANEL_PORT=8080
# Set 0.0.0.0 for direct public access.
PANEL_BIND=127.0.0.1
# External address for subscriptions; optional with direct panel access.
PANEL_PUBLIC_URL=
# For HTTPS through a reverse proxy; built-in HTTPS enables secure cookies itself.
PANEL_SECURE_COOKIE=false
# Used by compose.acme.yaml. Must match the HTTP challenge port in the panel.
PANEL_ACME_PORT=9080

# Bootstrap HTTPS before settings are saved in the panel.
PANEL_TLS_MODE=http
PANEL_DOMAIN=
PANEL_ACME_EMAIL=
PANEL_ACME_ACCEPT_TERMS=false
