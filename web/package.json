{
  "name": "hy2-panel-web",
  "private": true,
  "version": "0.8.0",
  "type": "module",
  "sideEffects": ["./src/main.tsx", "./src/config/i18n/setup.ts", "**/*.scss"],
  "scripts": {
    "dev": "rspack serve --mode development",
    "build": "tsc --noEmit && rspack build --mode production",
    "build:demo": "tsc --noEmit && rspack build --mode production --env demo",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src build rspack.config.ts",
    "lint": "prettier --check src build rspack.config.ts && tsc --noEmit",
    "test": "bun test tests/configuration tests/logs.test.ts tests/subscriptions",
    "test:ui": "playwright test --config tests/ui/playwright.config.ts",
    "docs:screenshots": "bun tests/screenshots/index.ts"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-select": "^2.4.1",
    "@tanstack/react-query": "5",
    "@twemoji/svg": "^15.0.0",
    "clsx": "^2.1.1",
    "emoji-picker-react": "^5.1.4",
    "emoji-regex": "^11.0.0",
    "flag-icons": "7.6.0",
    "i18next": "^26.7.1",
    "pixelarticons": "^2.4.2",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.91.0",
    "react-i18next": "^17.1.12",
    "tailwind-merge": "^3.7.0",
    "yaml": "2",
    "zustand": "5"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@rspack/cli": "^1.5.0",
    "@rspack/core": "^1.5.0",
    "@rspack/dev-server": "^1.1.0",
    "@tailwindcss/postcss": "4",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@zxing/library": "^0.23.0",
    "pngjs": "^7.0.0",
    "postcss": "8",
    "postcss-loader": "8",
    "prettier": "^3.9.10",
    "sass-embedded": "^1.108.1",
    "sass-loader": "^17.1.0",
    "tailwindcss": "4",
    "typescript": "^5.9.0"
  }
}
